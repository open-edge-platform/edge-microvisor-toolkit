From 4b3a0dc37e4fe301a9bfe8b3cf5a781b3f73e38d Mon Sep 17 00:00:00 2001
From: Junxiao Chang <junxiao.chang@intel.com>
Date: Sat, 16 May 2026 11:25:48 +0800
Subject: [PATCH 1/3] drm/i915: adding i915 parameter to disable stolen memory

Stolen memory might slow down real time performance. If RT
performance is important, "i915.enable_stolen=false" could be
applied to kernel command line to improve RT performance.

Signed-off-by: Junxiao Chang <junxiao.chang@intel.com>
---
 drivers/gpu/drm/i915/i915_params.c         | 3 +++
 drivers/gpu/drm/i915/i915_params.h         | 1 +
 drivers/gpu/drm/i915/intel_memory_region.c | 3 +++
 3 files changed, 7 insertions(+)

diff --git a/drivers/gpu/drm/i915/i915_params.c b/drivers/gpu/drm/i915/i915_params.c
index 8243033ec7ed..c59f80c3670b 100644
--- a/drivers/gpu/drm/i915/i915_params.c
+++ b/drivers/gpu/drm/i915/i915_params.c
@@ -135,6 +135,9 @@ i915_param_named(enable_gvt, bool, 0400,
 	"Enable support for Intel GVT-g graphics virtualization host support(default:false)");
 #endif
 
+i915_param_named(enable_stolen, bool, 0600,
+	"Enable support for Intel stolen memory (default:true)");
+
 #if CONFIG_DRM_I915_REQUEST_TIMEOUT
 i915_param_named_unsafe(request_timeout_ms, uint, 0600,
 			"Default request/fence/batch buffer expiration timeout.");
diff --git a/drivers/gpu/drm/i915/i915_params.h b/drivers/gpu/drm/i915/i915_params.h
index 1a53250ac2a5..8817219f9317 100644
--- a/drivers/gpu/drm/i915/i915_params.h
+++ b/drivers/gpu/drm/i915/i915_params.h
@@ -69,6 +69,7 @@ struct drm_printer;
 	param(bool, enable_hangcheck, true, 0600) \
 	param(bool, error_capture, true, IS_ENABLED(CONFIG_DRM_I915_CAPTURE_ERROR) ? 0600 : 0) \
 	param(bool, enable_gvt, false, IS_ENABLED(CONFIG_DRM_I915_GVT) ? 0400 : 0) \
+	param(bool, enable_stolen, true, 0600) \
 	param(bool, enable_debug_only_api, false, IS_ENABLED(CONFIG_DRM_I915_REPLAY_GPU_HANGS_API) ? 0400 : 0)
 
 #define MEMBER(T, member, ...) T member;
diff --git a/drivers/gpu/drm/i915/intel_memory_region.c b/drivers/gpu/drm/i915/intel_memory_region.c
index 308f4746de28..e91b16b82e2f 100644
--- a/drivers/gpu/drm/i915/intel_memory_region.c
+++ b/drivers/gpu/drm/i915/intel_memory_region.c
@@ -348,6 +348,9 @@ int intel_memory_regions_hw_probe(struct drm_i915_private *i915)
 
 		type = intel_region_map[i].class;
 		instance = intel_region_map[i].instance;
+		if ((type == INTEL_MEMORY_STOLEN_LOCAL || type == INTEL_MEMORY_STOLEN_SYSTEM)
+				&& !i915->params.enable_stolen)
+			continue;
 		switch (type) {
 		case INTEL_MEMORY_SYSTEM:
 			if (IS_DGFX(i915))
-- 
2.34.1

