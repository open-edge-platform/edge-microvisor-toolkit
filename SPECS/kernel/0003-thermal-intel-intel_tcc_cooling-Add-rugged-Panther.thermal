From 76bc711908bcc8c46963f29f826d0a950c43b78a Mon Sep 17 00:00:00 2001
From: Srinivas Pandruvada <srinivas.pandruvada@linux.intel.com>
Date: Mon, 20 Jul 2026 10:55:03 +0800
Subject: [PATCH 3/4] thermal: intel: intel_tcc_cooling: Add rugged Panther
 Lake support

Add TCC cooling support to rugged Panther Lake.

This tree's tcc_ids[] table did not yet carry the Panther Lake entries,
so add both INTEL_PANTHERLAKE_L and the rugged INTEL_PANTHERLAKE_R so
regular and rugged Panther Lake both get TCC cooling.

Signed-off-by: Srinivas Pandruvada <srinivas.pandruvada@linux.intel.com>
---
 drivers/thermal/intel/intel_tcc_cooling.c | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/drivers/thermal/intel/intel_tcc_cooling.c b/drivers/thermal/intel/intel_tcc_cooling.c
index f352ecafbedf..67c1b1568821 100644
--- a/drivers/thermal/intel/intel_tcc_cooling.c
+++ b/drivers/thermal/intel/intel_tcc_cooling.c
@@ -65,6 +65,8 @@ static const struct x86_cpu_id tcc_ids[] __initconst = {
 	X86_MATCH_VFM(INTEL_RAPTORLAKE, NULL),
 	X86_MATCH_VFM(INTEL_RAPTORLAKE_P, NULL),
 	X86_MATCH_VFM(INTEL_RAPTORLAKE_S, NULL),
+	X86_MATCH_VFM(INTEL_PANTHERLAKE_L, NULL),
+	X86_MATCH_VFM(INTEL_PANTHERLAKE_R, NULL),
 	{}
 };
 
-- 
2.34.1

