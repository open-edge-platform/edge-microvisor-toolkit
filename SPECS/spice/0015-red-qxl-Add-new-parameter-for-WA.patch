                           int fd,
                           uint32_t width, uint32_t height,
                           uint32_t stride, uint32_t format,
-                          int y_0_top);
+                          int y_0_top,
+                          bool hw_bypass);
 void spice_qxl_gl_draw_async(QXLInstance *qxl,
                              uint32_t x, uint32_t y,
                              uint32_t w, uint32_t h,
