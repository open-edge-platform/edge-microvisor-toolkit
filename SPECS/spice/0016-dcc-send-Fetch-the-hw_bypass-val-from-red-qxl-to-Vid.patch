From 6be832969984cbb9c96d23622174a27ad9ea6ad5 Mon Sep 17 00:00:00 2001
From: "Mazlan, Hazwan Arif" <hazwan.arif.mazlan@intel.com>
Date: Sun, 15 Jun 2025 14:29:42 +0800
Subject: [PATCH 16/16] dcc-send: Fetch the hw_bypass val from red-qxl to Video
 Encoder

Signed-off-by: Mazlan, Hazwan Arif <hazwan.arif.mazlan@intel.com>
---
 server/dcc-send.cpp        |  7 ++++++-
 server/gstreamer-encoder.c | 14 ++++++++++----
 server/video-encoder.h     |  1 +
 3 files changed, 17 insertions(+), 5 deletions(-)

diff --git a/server/dcc-send.cpp b/server/dcc-send.cpp
index 7d5b0a7b0143..87f68f7ba08b 100644
--- a/server/dcc-send.cpp
+++ b/server/dcc-send.cpp
@@ -1770,6 +1770,7 @@ static void red_marshall_gl_draw_stream(DisplayChannelClient *dcc,
     VideoStream *stream = display->priv->gl_draw_stream;
     int stream_id = display_channel_get_video_stream_id(display, stream);
     VideoStreamAgent *agent = &dcc->priv->stream_agents[stream_id];
+    bool hw_bypass = false;
 
     if (!agent->video_encoder || !agent->video_encoder->encode_dmabuf) {
         spice_warning("No video encoder available for this stream");
@@ -1799,10 +1800,14 @@ static void red_marshall_gl_draw_stream(DisplayChannelClient *dcc,
     dmabuf_data->free = red_free_cb;
     red_qxl_put_gl_scanout(qxl, scanout);
 
+    hw_bypass = red_qxl_get_gl_hw_bypass(qxl);
+
     VideoBuffer *outbuf;
     VideoEncodeResults ret;
 
-    ret = agent->video_encoder->encode_dmabuf(agent->video_encoder,
+    VideoEncoder *video_encoder = agent->video_encoder;
+    video_encoder->hw_bypass = hw_bypass;
+    ret = agent->video_encoder->encode_dmabuf(video_encoder,
                                               reds_get_mm_time(),
                                               dmabuf_data, &outbuf);
 
diff --git a/server/gstreamer-encoder.c b/server/gstreamer-encoder.c
index d3b9d439416e..a08a75fd41b4 100644
--- a/server/gstreamer-encoder.c
+++ b/server/gstreamer-encoder.c
@@ -294,6 +294,8 @@ typedef struct SpiceGstEncoder {
     /* How many frames were dropped by the server since the last encoded frame. */
     uint32_t server_drops;
     GstAllocator *allocator;
+
+    bool hw_bypass;
 } SpiceGstEncoder;
 
 
@@ -1680,10 +1682,12 @@ spice_gst_encoder_configure_pipeline(SpiceGstEncoder *encoder,
         return VIDEO_ENCODER_FRAME_UNSUPPORTED;
     }
 
-    if (handle_server_drops(encoder, frame_mm_time) ||
-        frame_mm_time < encoder->next_frame_mm_time) {
-        /* Drop the frame to limit the outgoing bit rate. */
-        return VIDEO_ENCODER_FRAME_DROP;
+    if(!encoder->hw_bypass) {
+        if (handle_server_drops(encoder, frame_mm_time) ||
+            frame_mm_time < encoder->next_frame_mm_time) {
+            /* Drop the frame to limit the outgoing bit rate. */
+            return VIDEO_ENCODER_FRAME_DROP;
+        }
     }
 
     if (!configure_pipeline(encoder)) {
@@ -1762,6 +1766,8 @@ spice_gst_encoder_encode_dmabuf(VideoEncoder *video_encoder,
                                 VideoBuffer **outbuf)
 {
     SpiceGstEncoder *encoder = (SpiceGstEncoder*)video_encoder;
+
+    encoder->hw_bypass = video_encoder->hw_bypass;
     g_return_val_if_fail(outbuf != NULL, VIDEO_ENCODER_FRAME_UNSUPPORTED);
     g_return_val_if_fail(dmabuf_data != NULL, VIDEO_ENCODER_FRAME_UNSUPPORTED);
     VideoEncodeResults rc;
diff --git a/server/video-encoder.h b/server/video-encoder.h
index a4cebe0a955a..b3e444687a57 100644
--- a/server/video-encoder.h
+++ b/server/video-encoder.h
@@ -156,6 +156,7 @@ struct VideoEncoder {
 
     /* The codec being used by the video encoder */
     SpiceVideoCodecType codec_type;
+    bool hw_bypass;
 };
 
 
