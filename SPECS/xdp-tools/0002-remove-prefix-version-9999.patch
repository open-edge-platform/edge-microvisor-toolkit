From 3ebe1af05888fb674f81a8241c2da292c2242a97 Mon Sep 17 00:00:00 2001
From: Aaron Chan <aaron.chun.yew.chan@intel.com>
Date: Fri, 30 May 2025 09:38:54 +0800
Subject: [PATCH 2/2] remove prefix version 9999

provided libbpf9999 where we added 9999 version prefix, this prefix can cause compilation error.

/usr/include/x86_64-linux-gnu/bits/string_fortified.h:95:10: error: 'strncpy' output truncated copying 9 bytes from a string of length 10 [-Werror=stringop-truncation]

Signed-off-by: Lee Chee Yang <chee.yang.lee@intel.com>provided libbpf9999 where we added 9999 version prefix, this prefix can cause compilation error.
---
 configure | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/configure b/configure
index 0c8014d..4841c39 100755
--- a/configure
+++ b/configure
@@ -328,7 +328,7 @@ check_libbpf()
 
         LIBBPF_CFLAGS=$(${PKG_CONFIG} libbpf --cflags)
         LIBBPF_LDLIBS=$(${PKG_CONFIG} libbpf --libs)
-        LIBBPF_VERSION=$(${PKG_CONFIG} libbpf --modversion)
+        LIBBPF_VERSION=$(${PKG_CONFIG} libbpf --modversion | sed 's/^9999.//')
 
         cat >$TMPDIR/libbpftest.c <<EOF
 #include <bpf/libbpf.h>
-- 
2.34.1

