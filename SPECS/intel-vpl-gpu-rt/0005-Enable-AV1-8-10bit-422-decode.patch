+++ b/_studio/shared/umc/io/umc_va/src/umc_va_linux.cpp
@@ -85,8 +85,10 @@ VAEntrypoint umc_to_va_entrypoint(uint32_t umc_entrypoint)
     switch (umc_entrypoint)
     {
     case UMC::VA_VLD:
+    case UMC::VA_VLD | UMC::VA_PROFILE_422:
     case UMC::VA_VLD | UMC::VA_PROFILE_444:
     case UMC::VA_VLD | UMC::VA_PROFILE_10:
+    case UMC::VA_VLD | UMC::VA_PROFILE_10 | UMC::VA_PROFILE_422:
     case UMC::VA_VLD | UMC::VA_PROFILE_10 | UMC::VA_PROFILE_444:
     case UMC::VA_VLD | UMC::VA_PROFILE_REXT:
     case UMC::VA_VLD | UMC::VA_PROFILE_REXT | UMC::VA_PROFILE_10:
@@ -283,6 +285,12 @@ VAProfile get_next_va_profile(uint32_t umc_codec, uint32_t profile)
     case UMC::VA_AV1 | UMC::VA_PROFILE_10:
         if (profile < UMC_ARRAY_SIZE(g_AV110BitsPProfiles)) va_profile = g_AV110BitsPProfiles[profile];
         break;
+#if VA_CHECK_VERSION(1, 23, 0)
+    case UMC::VA_AV1 | UMC::VA_PROFILE_422:
+    case UMC::VA_AV1 | UMC::VA_PROFILE_10 | UMC::VA_PROFILE_422:
+        if (profile < 1) va_profile = VAProfileAV1Profile2;
+        break;
+#endif
 #endif
     case UMC::VA_JPEG:
         if (profile < UMC_ARRAY_SIZE(g_JPEGProfiles)) va_profile = g_JPEGProfiles[profile];
