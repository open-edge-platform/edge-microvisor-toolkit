From f7e87b656f21b014514b3918baa00c6c2231f1aa Mon Sep 17 00:00:00 2001
From: "Mazlan, Hazwan Arif" <hazwan.arif.mazlan@intel.com>
Date: Wed, 11 Feb 2026 12:06:10 +0800
Subject: [PATCH 7/8] intel/dev: Remove force_probe for NVL-S/Hx enablement

Upstream URL: NA
Upstream-status: Pending

OSV: https://jira.devtools.intel.com/browse/PKT-20283

Signed-off-by: Mazlan, Hazwan Arif <hazwan.arif.mazlan@intel.com>
---
 include/pci_ids/iris_pci_ids.h | 12 ++++++------
 1 file changed, 6 insertions(+), 6 deletions(-)

diff --git a/include/pci_ids/iris_pci_ids.h b/include/pci_ids/iris_pci_ids.h
index 44c97d912e6..24a8164f0dc 100644
--- a/include/pci_ids/iris_pci_ids.h
+++ b/include/pci_ids/iris_pci_ids.h
@@ -304,9 +304,9 @@ CHIPSET(0xb0b0, ptl, "PTL", "Intel(R) Graphics")
 CHIPSET(0xfd80, wcl, "WCL", "Intel(R) Graphics")
 CHIPSET(0xfd81, wcl, "WCL", "Intel(R) Graphics")
 
-CHIPSET(0xd740, nvl_s_hx_ul, "NVL-S", "Intel(R) Graphics", FORCE_PROBE)
-CHIPSET(0xd741, nvl_u_h, "NVL-U", "Intel(R) Graphics", FORCE_PROBE)
-CHIPSET(0xd742, nvl_u_h, "NVL-H", "Intel(R) Graphics", FORCE_PROBE)
-CHIPSET(0xd743, nvl_s_hx_ul, "NVL-HX", "Intel(R) Graphics", FORCE_PROBE)
-CHIPSET(0xd744, nvl_s_hx_ul, "NVL-UL", "Intel(R) Graphics", FORCE_PROBE)
-CHIPSET(0xd745, nvl_s_hx_ul, "NVL-HX", "Intel(R) Graphics", FORCE_PROBE)
+CHIPSET(0xd740, nvl_s_hx_ul, "NVL-S", "Intel(R) Graphics")
+CHIPSET(0xd741, nvl_u_h, "NVL-U", "Intel(R) Graphics")
+CHIPSET(0xd742, nvl_u_h, "NVL-H", "Intel(R) Graphics")
+CHIPSET(0xd743, nvl_s_hx_ul, "NVL-HX", "Intel(R) Graphics")
+CHIPSET(0xd744, nvl_s_hx_ul, "NVL-UL", "Intel(R) Graphics")
+CHIPSET(0xd745, nvl_s_hx_ul, "NVL-HX", "Intel(R) Graphics")
