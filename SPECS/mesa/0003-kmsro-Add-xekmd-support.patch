From 2c2e77bd5863ad77447f53d3466067d2ae9cf845 Mon Sep 17 00:00:00 2001
From: "Mazlan, Hazwan Arif" <hazwan.arif.mazlan@intel.com>
Date: Wed, 19 Nov 2025 10:33:51 +0800
Subject: [PATCH 3/8] kmsro: Add xekmd support

Upstream PR: NA
Upstream-status: Innapropriate

OSV: https://jira.devtools.intel.com/browse/PKT-19625

Signed-off-by: Chew, Tong Liang <tong.liang.chew@intel.com>
Signed-off-by: Mazlan, Hazwan Arif <hazwan.arif.mazlan@intel.com>
---
 src/gallium/auxiliary/pipe-loader/pipe_loader_drm.c | 1 +
 src/gallium/winsys/kmsro/drm/kmsro_drm_winsys.c     | 5 +++++
 2 files changed, 6 insertions(+)

diff --git a/src/gallium/auxiliary/pipe-loader/pipe_loader_drm.c b/src/gallium/auxiliary/pipe-loader/pipe_loader_drm.c
index 0c4b4499b25..3c933910d0e 100644
--- a/src/gallium/auxiliary/pipe-loader/pipe_loader_drm.c
+++ b/src/gallium/auxiliary/pipe-loader/pipe_loader_drm.c
@@ -391,6 +391,7 @@ pipe_loader_get_compatible_render_capable_device_fds(int kms_only_fd, unsigned i
 #endif
 #if defined GALLIUM_IRIS
      "i915",
+     "xe",
 #endif
    };
 
diff --git a/src/gallium/winsys/kmsro/drm/kmsro_drm_winsys.c b/src/gallium/winsys/kmsro/drm/kmsro_drm_winsys.c
index e676c633572..ff6c6466fb5 100644
--- a/src/gallium/winsys/kmsro/drm/kmsro_drm_winsys.c
+++ b/src/gallium/winsys/kmsro/drm/kmsro_drm_winsys.c
@@ -131,6 +131,11 @@ struct pipe_screen *kmsro_drm_screen_create(int kms_fd,
 #if defined(GALLIUM_IRIS)
 	 ro->create_for_resource = renderonly_create_kms_dumb_buffer_for_resource;
 	 screen = iris_drm_screen_create_renderonly(ro->gpu_fd, ro, config);
+#endif
+      } else if (strcmp(render_dev_name, "xe") == 0) {
+#if defined(GALLIUM_IRIS)
+	 ro->create_for_resource = renderonly_create_kms_dumb_buffer_for_resource;
+	 screen = iris_drm_screen_create_renderonly(ro->gpu_fd, ro, config);
 #endif
       }
 
