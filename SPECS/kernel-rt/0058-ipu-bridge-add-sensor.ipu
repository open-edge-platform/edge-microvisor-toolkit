From 5c46ff5c6a8e44c89f15b95efce53760d75c84c3 Mon Sep 17 00:00:00 2001
From: "Mokhtar, Mohamad Nor Syahid" <mohamad.nor.syahid.mokhtar@intel.com>
Date: Wed, 10 Jun 2026 13:45:44 +0800
Subject: [PATCH 58/65] ipu-bridge add sensor

Signed-off-by: Mokhtar, Mohamad Nor Syahid <mohamad.nor.syahid.mokhtar@intel.com>
---
 drivers/media/pci/intel/ipu-bridge.c | 10 ++++++++++
 1 file changed, 10 insertions(+)

diff --git a/drivers/media/pci/intel/ipu-bridge.c b/drivers/media/pci/intel/ipu-bridge.c
index d049db382e01..7126c376534c 100644
--- a/drivers/media/pci/intel/ipu-bridge.c
+++ b/drivers/media/pci/intel/ipu-bridge.c
@@ -102,6 +102,16 @@ static const struct ipu_sensor_config ipu_supported_sensors[] = {
 	IPU_SENSOR_CONFIG("XMCC0003", 1, 321468000),
 	/* Lontium lt6911gxd */
 	IPU_SENSOR_CONFIG("INTC1124", 0),
+	/* D3 Embedded ISX031 */
+	IPU_SENSOR_CONFIG("INTC113C", 1, 300000000),
+	/* LI AR0830 */
+	IPU_SENSOR_CONFIG("LIAR0830", 1, 600000000),
+	/* Innodisk AR0822 */
+	IPU_SENSOR_CONFIG("EV8MOOM1", 1, 600000000),
+	/* LI IMX415 */
+	IPU_SENSOR_CONFIG("IMXSN415", 1, 445500000),
+	/* LI IMX586 */
+	IPU_SENSOR_CONFIG("IMXSN586", 1, 1000000000),
 };
 
 /*
