 	u8 lanes;
 	u32 mclkspeed;
 	u32 rotation;
 	enum v4l2_fwnode_orientation orientation;
 	const char *vcm_type;
+#if IS_ENABLED(CONFIG_VIDEO_INTEL_IPU7)
+	u8 phyconfig;
+#endif
 
 	struct ipu_property_names prop_names;
 	struct property_entry ep_properties[5];
 	struct property_entry dev_properties[5];
+#if IS_ENABLED(CONFIG_VIDEO_INTEL_IPU7)
