From 94f6875d86193d5f2f073c71623d5e47c2fc2e77 Mon Sep 17 00:00:00 2001
From: KhaiWenTan <khai.wen.tan@intel.com>
Date: Wed, 24 Dec 2025 15:13:12 +0800
Subject: [PATCH 17/17] igc: Remove XDP metadata invalidation

Delete the else branch that invalidates XDP metadata when RX
timestamping is off. Only set metadata when hardware RX timestamping
is enabled, simplifying the receive path logic.

Fixes: c2697c3fa88d ("igc: Enable HW RX Timestamp for AF_XDP ZC")
Signed-off-by: KhaiWenTan <khai.wen.tan@intel.com>
Signed-off-by: Song Yoong Siang <yoong.siang.song@intel.com>
---
 drivers/net/ethernet/intel/igc/igc_main.c | 2 --
 1 file changed, 2 deletions(-)

diff --git a/drivers/net/ethernet/intel/igc/igc_main.c b/drivers/net/ethernet/intel/igc/igc_main.c
index dc36f692492c..a5d724359fa5 100644
--- a/drivers/net/ethernet/intel/igc/igc_main.c
+++ b/drivers/net/ethernet/intel/igc/igc_main.c
@@ -2872,8 +2872,6 @@ static int igc_clean_rx_irq_zc(struct igc_q_vector *q_vector, const int budget)
 			md = bi->xdp->data - sizeof(*md);
 			md->timestamp = igc_ptp_rx_pktstamp(adapter, ctx->rx_ts->timer0);
 			bi->xdp->data_meta = md;
-		} else {
-			xdp_set_data_meta_invalid(bi->xdp);
 		}
 
 		res = __igc_xdp_run_prog(adapter, prog, bi->xdp);
-- 
2.43.0

